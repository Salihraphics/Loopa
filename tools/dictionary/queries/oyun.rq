# Video games, board/card/children's games and sports with a Turkish Wikipedia article
SELECT ?item ?label ?alt WHERE {
  VALUES ?c { wd:Q7889 wd:Q131436 wd:Q142714 wd:Q349 wd:Q1137556 wd:Q11410 wd:Q31629 wd:Q1781513 }
  ?item wdt:P31 ?c .
  ?article schema:isPartOf <https://tr.wikipedia.org/>; schema:about ?item .
  ?item rdfs:label ?label FILTER(lang(?label)="tr")
  OPTIONAL { ?item skos:altLabel ?alt FILTER(lang(?alt)="tr") }
}
